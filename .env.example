GARMIN_EMAIL=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# Or use LiteLLM proxy instead of direct API:
# ANTHROPIC_BASE_URL=http://localhost:4000
VITALFORGE_USER=admin
VITALFORGE_PASS=changeme
# Set this explicitly in every deployment. If unset or left as the placeholder,
# each process generates its own temporary secret: sessions won't survive a
# restart and the two services won't share sign-on.
VITALFORGE_SECRET=change-this-to-a-random-string
# Upgrade compatibility only: on first startup this legacy shared token is
# imported once as a named token owned by the first admin. New installations
# should leave this empty and create per-user tokens from /auth/account.
VITALFORGE_API_TOKEN=
# Public URLs for cross-service navigation (used in nav links)
# WEIGHT_URL=https://weight.yourdomain.com
# DASHBOARD_URL=https://health.yourdomain.com
# Default unit for weight display: "lbs" or "kg" (default: lbs)
# DEFAULT_UNIT=lbs
# IANA timezone for timestamps (e.g. America/New_York). Omit for browser default.
# ALSO used server-side for the Garmin activity wall-clock conversion:
# POST /p/{slug}/api/activity stores `start` as UTC but create_manual_activity
# wants a local wall-clock string plus this zone name, so an unset TZ files
# strength sessions against UTC (logged at WARNING) rather than local time.
# TZ=America/New_York
# Attempt the per-exercise exerciseSets upload after creating the Garmin
# activity. Ships OFF: the request payload's JSON field names are unverified
# against a real account, and Garmin may not accept exercise sets on a
# manually created activity at all. Leave at 0 until both are confirmed.
VITALFORGE_GARMIN_EXERCISE_SETS=0

name: Build and Push Docker Images

on:
  push:
    branches: [main]
    tags: ['v*']
  pull_request:
    branches: [main]

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v6

      - name: Set up Python
        uses: actions/setup-python@v6
        with:
          python-version: "3.12"

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install -r vitalforge-weight/requirements.txt -r vitalforge-dashboard/requirements.txt
          pip install pytest pytest-asyncio httpx ruff playwright pytest-playwright pip-audit
          pip install -e .

      - name: Lint (ruff)
        run: ruff check .

      - name: Run tests
        run: pytest -q

      # Nothing was auditing dependencies before this: the starlette advisory
      # that prompted issue #37 surfaced from a one-off run during a code
      # review, which is not a process. So this blocks the image push.
      #
      # It runs AFTER the tests on purpose. An advisory published upstream
      # turns this red on a day nobody changed anything, and a red audit ahead
      # of `pytest` would mask the test signal for whoever is mid-change.
      #
      # Scoped to the two requirements files rather than the whole installed
      # environment, deliberately. pip-audit still resolves and audits their
      # TRANSITIVE dependencies -- which is what matters here, since starlette
      # was transitive until this commit -- but an advisory in pytest, ruff or
      # playwright will not block an image push for a vulnerability that never
      # ships in the image.
      - name: Audit dependencies (pip-audit)
        run: |
          pip-audit --progress-spinner off \
            -r vitalforge-weight/requirements.txt \
            -r vitalforge-dashboard/requirements.txt

      - name: Install Playwright browser
        run: playwright install --with-deps chromium

      # Run separately from the main suite: pytest-playwright's browser fixture keeps its
      # own event loop running for the rest of the session, which breaks pytest-asyncio
      # fixtures if run in the same process (see pyproject.toml's `addopts` comment).
      - name: Run UI smoke tests (Playwright)
        run: pytest -q -m playwright

  build-and-push:
    needs: test
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write

    strategy:
      matrix:
        service:
          - name: vitalforge-weight
            dockerfile: vitalforge-weight/Dockerfile
          - name: vitalforge-dashboard
            dockerfile: vitalforge-dashboard/Dockerfile

    steps:
      - name: Checkout
        uses: actions/checkout@v6

      - name: Log in to GHCR
        if: github.event_name != 'pull_request'
        uses: docker/login-action@v4
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Log in to Docker Hub
        if: github.event_name != 'pull_request'
        uses: docker/login-action@v4
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - name: Extract metadata
        id: meta
        uses: docker/metadata-action@v6
        with:
          images: |
            ghcr.io/${{ github.repository_owner }}/${{ matrix.service.name }}
            docker.io/${{ secrets.DOCKERHUB_USERNAME }}/${{ matrix.service.name }}
          tags: |
            type=ref,event=branch
            type=semver,pattern={{version}}
            type=sha,prefix=
            type=raw,value=latest,enable={{is_default_branch}}

      - name: Build and push
        uses: docker/build-push-action@v7
        with:
          context: .
          file: ${{ matrix.service.dockerfile }}
          push: ${{ github.event_name != 'pull_request' }}
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
